/* ========================================
   Catppuccin Mocha — Second Brain TUI
   ======================================== */

/* --- Color Tokens (Reference) ---
   Base:     #1e1e2e    Mantle:   #181825
   Surface0: #313244    Surface1: #45475a
   Surface2: #585b70    Overlay0: #6c7086
   Text:     #cdd6f4    Subtext1: #bac2de
   Subtext0: #a6adc8    Lavender: #b4befe
   Mauve:    #cba6f7    Teal:     #94e2d5
   Peach:    #fab387    Red:      #f38ba8
   Green:    #a6e3a1    Yellow:   #f9e2af
   ---------------------------------------- */


/* === Layout: Sidebar === */

#sidebar {
    width: 25%;
    height: 100%;
    background: #181825;
    border-right: tall #313244;
}

#file-tree {
    background: transparent;
    border: none;
}

#file-tree:focus {
    background: #1e1e2e;
}


/* === Layout: Main Content === */

#main-content {
    width: 75%;
    height: 100%;
}


/* === Note Viewer Panel === */

#note-viewer-container {
    display: none;
    height: 3fr;
    background: #1e1e2e;
    border: round #45475a;
    margin: 1 2 0 2;
    layout: vertical;
}

#note-viewer-header {
    height: 3;
    background: #313244;
    border-bottom: solid #45475a;
    padding: 0 1;
    align: left middle;
}

#note-viewer-title {
    width: 1fr;
    color: #b4befe;
    text-style: bold;
    content-align: left middle;
}

#close-note-btn {
    width: 5;
    height: 1;
    min-width: 5;
    padding: 0;
    margin: 0;
    background: #45475a;
    color: #f38ba8;
}

#close-note-btn:hover {
    background: #f38ba8;
    color: #1e1e2e;
}

#note-viewer {
    height: 1fr;
    background: transparent;
    color: #cdd6f4;
    padding: 1 2;
    overflow-y: auto;
}

#note-viewer:focus {
    background: #181825;
}


/* === Chat Area === */

#chat-area {
    width: 100%;
    height: 2fr;
    padding: 0 2 1 2;
}

#chat-log {
    width: 100%;
    height: 1fr;
    background: #181825;
    color: #cdd6f4;
    border: round #313244;
    padding: 1 2;
    overflow-y: auto;
}

#chat-log:focus {
    border: round #cba6f7;
}


/* === Loading Status === */

#loading-status {
    display: none;
    height: 1;
    width: 100%;
    color: #fab387;
    background: transparent;
    text-align: center;
    text-style: bold;
    margin-top: 1;
}


/* === Chat Input === */

#chat-input {
    width: 100%;
    height: 3;
    background: #313244;
    border: tall #45475a;
    color: #cdd6f4;
    margin-top: 0;
}

#chat-input:focus {
    border: double #cba6f7;
    background: #1e1e2e;
}


/* === Mention Autocomplete === */

#mention-autocomplete {
    display: none;
    width: 100%;
    height: 5;
    background: #1e1e2e;
    border: round #cba6f7;
    color: #cdd6f4;
}


/* === Scrollbar === */

ScrollBar {
    background: #313244;
    color: #cba6f7;
}

ScrollBar:hover {
    color: #b4befe;
}


/* === Header & Footer === */

Header {
    background: #1e1e2e;
    color: #cba6f7;
}

HeaderTitle {
    color: #cba6f7;
    text-style: bold;
}

Footer {
    background: #181825;
    color: #a6adc8;
}

FooterKey {
    background: #313244;
    color: #cba6f7;
}