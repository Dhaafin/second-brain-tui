/* ========================================
   Catppuccin Mocha — Second Brain TUI
   ======================================== */

/* --- Color Tokens (Reference) ---
   Base:     #1e1e2e    Mantle:   #181825
   Surface0: #313244    Surface1: #45475a
   Surface2: #585b70    Overlay0: #6c7086
   Text:     #cdd6f4    Subtext1: #bac2de
   Subtext0: #a6adc8    Lavender: #b4befe
   Mauve:    #cba6f7    Teal:     #94e2d5
   Peach:    #fab387    Red:      #f38ba8
   Green:    #a6e3a1    Yellow:   #f9e2af
   ---------------------------------------- */


/* === Layout: Sidebar === */

#sidebar {
    width: 25%;
    height: 100%;
    background: #181825;
    border-right: tall #313244;
}

#file-tree {
    background: transparent;
    border: none;
}

#file-tree:focus {
    background: #1e1e2e;
}


/* === Layout: Main Content === */

#main-content {
    width: 75%;
    height: 100%;
}


/* === Note Viewer Panel === */

#note-viewer-container {
    display: none;
    height: 3fr;
    background: #1e1e2e;
    border: round #45475a;
    margin: 1 2 0 2;
    layout: vertical;
}

#note-viewer-header {
    height: 3;
    background: #313244;
    border-bottom: solid #45475a;
    padding: 0 1;
    align: left middle;
}

#note-viewer-title {
    width: 1fr;
    color: #b4befe;
    text-style: bold;
    content-align: left middle;
}

#close-note-btn {
    width: 5;
    height: 1;
    min-width: 5;
    padding: 0;
    margin: 0;
    background: #45475a;
    color: #f38ba8;
    border: none;
}

#close-note-btn:hover {
    background: #f38ba8;
    color: #1e1e2e;
    text-style: bold;
}

#note-viewer {
    height: 1fr;
    background: transparent;
    color: #cdd6f4;
    padding: 1 2;
    overflow-y: auto;
}

#note-viewer:focus {
    background: #181825;
}


/* === Chat Area === */

#chat-area {
    width: 100%;
    height: 2fr;
    padding: 0 2 1 2;
}

#chat-log-container {
    width: 100%;
    height: 1fr;
    background: #181825;
    border: round #313244;
    padding: 1 2;
    overflow-y: scroll;
    layout: vertical;
}

#chat-log-container:focus {
    border: round #cba6f7;
}

.chat-message {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    padding: 1 2;
}

.chat-message-user {
    background: #313244;
    border-left: thick #b4befe;
}

.chat-message-agent {
    background: #181825;
    border-left: thick #cba6f7;
}

.chat-bubble-header {
    text-style: bold;
    margin-bottom: 1;
}

.chat-bubble-header.user-header {
    color: #b4befe;
}

.chat-bubble-header.agent-header {
    color: #cba6f7;
}

.chat-bubble-content {
    background: transparent;
    color: #cdd6f4;
    padding: 0;
}

/* === Status Dashboard === */
#status-dashboard {
    height: 1;
    background: transparent;
    padding: 0 1;
    layout: horizontal;
    margin-top: 1;
}

#status-dashboard Label {
    margin-right: 4;
    text-style: bold;
}

#dashboard-rag {
    color: #a6e3a1; /* Catppuccin Green */
}

#dashboard-model {
    color: #fab387; /* Catppuccin Peach */
}

#dashboard-tip {
    color: #94e2d5; /* Catppuccin Teal */
    width: 1fr;
    text-align: right;
}


/* === Loading Status === */

#loading-status {
    display: none;
    height: 1;
    width: 100%;
    color: #fab387;
    background: transparent;
    text-align: center;
    text-style: bold;
    margin-top: 1;
}


/* === Chat Input === */

#chat-input {
    width: 100%;
    height: 3;
    background: #313244;
    border: tall #45475a;
    color: #cdd6f4;
    margin-top: 0;
}

#chat-input:focus {
    border: double #cba6f7;
    background: #1e1e2e;
}


/* === Mention Autocomplete === */

#mention-autocomplete {
    display: none;
    dock: bottom;
    width: 75%;
    height: auto;
    max-height: 8;
    background: #181825;
    border: round #cba6f7;
    color: #cdd6f4;
    margin-bottom: 3;
    margin-left: 2;
}


/* === Scrollbar === */

ScrollBar {
    background: #313244;
    color: #cba6f7;
}

ScrollBar:hover {
    color: #b4befe;
}


/* === Header & Footer === */

Header {
    background: #1e1e2e;
    color: #cba6f7;
}

HeaderTitle {
    color: #cba6f7;
    text-style: bold;
}

Footer {
    background: #181825;
    color: #a6adc8;
}

FooterKey {
    background: #313244;
    color: #cba6f7;
}

/* === Settings Modal === */
SettingsModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.0);
}

#settings-container {
    width: 55;
    height: auto;
    background: #1e1e2e;
    border: thick #cba6f7;
    border-title-color: #cba6f7;
    border-title-style: bold;
    padding: 1 2;
    opacity: 0.0;
}

.settings-row {
    height: 3;
    align: left middle;
}

.settings-label {
    width: 1fr;
    color: #cdd6f4;
    content-align: left middle;
}

#settings-buttons {
    margin-top: 1;
    height: 3;
    align: right middle;
}

#settings-buttons Button {
    margin-left: 1;
}

#sidebar-settings-btn {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
    background: #313244;
    color: #cba6f7;
    border: tall #45475a;
}

#sidebar-settings-btn:hover {
    background: #cba6f7;
    color: #1e1e2e;
}

/* === File Modals === */
ConfirmModal, PromptModal, ContextMenuModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.0);
}

#confirm-container, #prompt-container, #context-menu-container {
    width: 45;
    height: auto;
    background: #1e1e2e;
    border: thick #cba6f7;
    padding: 1 2;
    opacity: 0.0;
}

#context-menu-container {
    width: 32;
    padding: 1;
}

#confirm-message, #prompt-title, #context-menu-title {
    color: #cdd6f4;
    margin-bottom: 1;
    text-align: center;
}

#context-menu-title {
    color: #cba6f7;
    text-style: bold;
}

#context-menu-list {
    background: transparent;
    border: none;
    height: auto;
    max-height: 8;
}

#prompt-input {
    width: 100%;
    margin-bottom: 1;
    background: #313244;
    border: tall #45475a;
    color: #cdd6f4;
}

#prompt-input:focus {
    border: double #cba6f7;
}

#confirm-buttons, #prompt-buttons {
    align: right middle;
    layout: horizontal;
    height: 3;
}

#confirm-buttons Button, #prompt-buttons Button {
    margin-left: 1;
}