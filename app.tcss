#sidebar {
    width: 30%;
    height: 100%;
    background: #1e293b; /* Slate 800 */
    border-right: tall #334155; /* Garis vertikal pembatas */
}

#file-tree {
    background: transparent;
    border: none;
}

#main-content {
    width: 70%;
    height: 100%;
}

#note-viewer-container {
    display: none; /* Sembunyikan di awal */
    height: 3fr;   /* 60% dari ruang vertikal jika ditampilkan */
    background: #1e293b; /* Slate 800 */
    border: round #334155;
    margin: 1 2 0 2;
    layout: vertical;
}

#note-viewer-header {
    height: 3;
    background: #334155; /* Slate 700 / dark header */
    border-bottom: solid #475569;
    padding: 0 1;
    align: left middle;
}

#note-viewer-title {
    width: 1fr;
    color: #fbbf24; /* Amber title text */
    text-style: bold;
    content-align: left middle;
}

#close-note-btn {
    width: 5;
    height: 1;
    min-width: 5;
    padding: 0;
    margin: 0;
}

#note-viewer {
    height: 1fr;
    background: transparent;
    color: #f8fafc;
    padding: 1 2;
    overflow-y: auto; /* Tampilkan scrollbar saat teks meluap */
}

#note-viewer:focus {
    background: #151e2e;
}

/* Custom ScrollBar (Slider) styling */
ScrollBar {
    background: #334155;
    color: #6366f1; /* Neon indigo scrollbar thumb */
}

ScrollBar:hover {
    color: #818cf8;
}

#chat-area {
    width: 100%;
    height: 2fr;   /* 40% tinggi jika ada note-viewer, 100% jika note-viewer disembunyikan */
    padding: 0 2 1 2;
}

#chat-log {
    width: 100%;
    height: 1fr;
    background: #090d16;
    color: #f8fafc;
    border: round #475569;
    padding: 1 2;
}

#loading-status {
    display: none;
    height: 1;
    width: 100%;
    color: #fbbf24; /* Amber */
    background: transparent;
    text-align: center;
    text-style: bold;
    margin-top: 1;
}

#chat-input {
    width: 100%;
    height: 3;
    background: #1e293b;
    border: tall #6366f1; /* Neon indigo */
    color: #f8fafc;
    margin-top: 0;
}

#chat-input:focus {
    border: double #a5b4fc;
}